{
  "name": "bentar",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "npm run dev:server & npm run dev:web",
    "dev:web": "npm run dev -w @bentar/web",
    "dev:server": "npm run dev -w @bentar/server",
    "build": "npm run build -w @bentar/shared && npm run build -w @bentar/server && npm run build -w @bentar/web",
    "build:web": "npm run build -w @bentar/web",
    "build:server": "npm run build -w @bentar/server"
  }
}

<div class="user-presence">
  <div class="panel-header">
    <h3>Online Users</h3>
    <span id="user-count" class="badge">0</span>
  </div>
  <ul id="users-list" class="users-list">
    <li class="empty">No users online</li>
  </ul>
</div>

<style>
  .user-presence {
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .panel-header h3 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .badge {
    background: var(--color-primary);
    color: white;
    font-size: 0.625rem;
    font-weight: 600;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    min-width: 1.25rem;
    text-align: center;
  }

  .users-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    max-height: 200px;
    overflow-y: auto;
  }

  .users-list :global(.user-item) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: 6px;
    font-size: 0.8125rem;
  }

  .users-list :global(.user-avatar) {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.625rem;
    font-weight: 700;
    color: white;
    flex-shrink: 0;
  }

  .users-list :global(.user-source) {
    font-size: 0.625rem;
    color: var(--color-text-muted);
    margin-left: auto;
    text-transform: uppercase;
  }

  .users-list .empty {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    padding: 0.5rem;
    text-align: center;
  }
</style>

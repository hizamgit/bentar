<div class="model-tree">
  <div class="panel-header">
    <h3>Element Tree</h3>
  </div>
  <div id="element-tree" class="tree-content">
    <p class="empty">Load a model to see its structure</p>
  </div>
</div>

<style>
  .model-tree {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .panel-header {
    padding: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .panel-header h3 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .tree-content {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem;
  }

  .tree-content :global(.tree-node) {
    padding-left: 0.75rem;
  }

  .tree-content :global(.tree-item) {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.375rem;
    border-radius: 4px;
    font-size: 0.75rem;
    cursor: pointer;
    transition: background 0.15s;
    white-space: nowrap;
  }

  .tree-content :global(.tree-item:hover) {
    background: var(--color-surface-hover);
  }

  .tree-content :global(.tree-item.selected) {
    background: rgba(59, 130, 246, 0.15);
    color: var(--color-primary);
  }

  .tree-content :global(.tree-toggle) {
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .tree-content :global(.tree-icon) {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .empty {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    text-align: center;
    padding: 1rem 0.5rem;
  }
</style>
